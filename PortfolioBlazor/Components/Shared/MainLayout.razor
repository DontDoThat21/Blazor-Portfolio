@inherits LayoutComponentBase

<PageTitle>Tylor T's Portfolio</PageTitle>

<div class="d-flex flex-column min-vh-100 bg-dark">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <button class="btn btn-outline-light me-2" type="button" @onclick="DrawerToggle" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a class="navbar-brand" href="/">Tylor T's Portfolio</a>

            <div class="ms-auto dropdown me-3">
                <button class="btn btn-outline-light dropdown-toggle" type="button" @onclick="MenuToggle" aria-expanded="@_menuOpen">
                    Menu
                </button>
                <ul class="dropdown-menu dropdown-menu-end @(_menuOpen ? "show" : "")">
                    <li><a class="dropdown-item" href="/Login">Login</a></li>
                    <li><a class="dropdown-item" href="/Register">Register</a></li>
                    <li><a class="dropdown-item" href="/Logout">Log out</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="d-flex flex-grow-1">
        <aside class="bg-dark.bg-gradient border-end" style="width: 260px;" hidden="@(!_drawerOpen)">
            <nav class="nav flex-column p-2">
                <NavLink class="nav-link" href="/">Home</NavLink>

                <div class="mt-2">
                    <small class="text-uppercase text-muted px-2">Projects</small>
                    <div class="nav flex-column ms-2">
                        <NavLink class="nav-link" href="/Projects/Index">All Projects</NavLink>
                        <NavLink class="nav-link" href="/Projects/MauiTodos">.NET Maui Todo List</NavLink>
                        <NavLink class="nav-link" href="/Projects/AngularEmployeeManager">Angular 16 Employee Manager</NavLink>
                        <NavLink class="nav-link" href="/Projects/AngularAPI">.NET FW Angular API</NavLink>
                        <NavLink class="nav-link" href="/Projects/WinFormsTodos">Win Forms Todos</NavLink>
                        <NavLink class="nav-link" href="/Projects/CppCalculator">C++ WinForms Calculator</NavLink>
                    </div>
                </div>

                <div class="mt-2">
                    <small class="text-uppercase text-muted px-2">Motorcycles</small>
                    <div class="nav flex-column ms-2">
                        <NavLink class="nav-link" href="/Motorcycles/Index">Motorcycles overview</NavLink>
                        <NavLink class="nav-link" href="/Motorcycles/Collection">Motorcycle Footage</NavLink>
                        <NavLink class="nav-link" href="/Motorcycles/Store">Store</NavLink>
                    </div>
                </div>

                <div class="mt-2">
                    <small class="text-uppercase text-muted px-2">Books</small>
                    <div class="nav flex-column ms-2">
                        <NavLink class="nav-link" href="/Categories/Index">Book Categories</NavLink>
                        <NavLink class="nav-link" href="/Product/Index">Products</NavLink>
                        <NavLink class="nav-link" href="/Companies/Index">Companies</NavLink>
                    </div>
                </div>

                <NavLink class="nav-link mt-2" href="/Orders/Index">Manage Orders</NavLink>
                <NavLink class="nav-link" href="/Carts/Index">Cart</NavLink>

                <div class="mt-2">
                    <small class="text-uppercase text-muted px-2">Games</small>
                    <div class="nav flex-column ms-2">
                        <NavLink class="nav-link" href="/Games/Index">Games</NavLink>
                        <NavLink class="nav-link" href="/Games/Hangman">Hangman</NavLink>
                        <NavLink class="nav-link" href="/Games/SimonSays">Simon Says</NavLink>
                    </div>
                </div>

                <NavLink class="nav-link mt-2" href="/Home/Privacy">Privacy</NavLink>
            </nav>
        </aside>

        <main class="flex-grow-1 p-3">
            @Body
        </main>
    </div>
</div>
 
@code 
{
    bool _drawerOpen = true;
    bool _menuOpen = false;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    void MenuToggle()
    {
        _menuOpen = !_menuOpen;
    }
}