@using System.Diagnostics
@using PortfolioBlazor.DTO.Models
@inject NavigationManager nav

<div class="container-fluid px-4">
    <!-- Header Section -->
    <div class="row align-items-center mb-4 pt-4">
        <div class="col-12 col-md-6">
            <h2 class="text-primary fw-bold mb-2">
                <i class="bi bi-bicycle"></i> Motorcycle Store
            </h2>
            <p class="text-muted mb-0">New and used bikes inventory</p>
        </div>
        <div class="col-12 col-md-6 mt-3 mt-md-0">
            <div class="d-flex gap-2 justify-content-md-end">
                <button class="btn btn-outline-secondary" @onclick="ClearFilters" disabled="@(isLoading)">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </button>
                <a class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-circle"></i> Add New Motorcycle
                </a>
            </div>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0 shadow-sm" 
                       placeholder="Search by name..." 
                       @bind="nameFilter" 
                       @bind:event="oninput"
                       disabled="@(isLoading)" />
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-gear text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0 shadow-sm" 
                       placeholder="Search by manufacturer..." 
                       @bind="manufacturerFilter" 
                       @bind:event="oninput"
                       disabled="@(isLoading)" />
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <select class="form-select shadow-sm" @bind="engineStyleFilter" disabled="@(isLoading)">
                <option value="">All Engine Styles</option>
                @foreach (var style in uniqueEngineStyles)
                {
                    <option value="@style">@style</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <select class="form-select shadow-sm" @bind="yearFilter" disabled="@(isLoading)">
                <option value="">All Years</option>
                @foreach (var year in uniqueYears.OrderByDescending(y => y))
                {
                    <option value="@year">@year</option>
                }
            </select>
        </div>
    </div>

    <!-- Results Summary -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                @if (isLoading)
                {
                    <small class="text-muted">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        Loading motorcycles...
                    </small>
                }
                else
                {
                    <small class="text-muted">
                        Showing <strong>@filteredMotorcycles.Count</strong> of <strong>@motorcycles.Count</strong> motorcycles
                    </small>
                }
                @if (hasActiveFilters && !isLoading)
                {
                    <small class="text-info">
                        <i class="bi bi-funnel"></i> Filters active
                    </small>
                }
            </div>
        </div>
    </div>

    <!-- Motorcycles Table -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm product-table-card">
                <div class="card-body p-0">
                    @if (isLoading)
                    {
                        <!-- Loading Skeleton -->
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-bicycle me-2"></i>Motorcycle
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-gear me-2"></i>Manufacturer
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-speedometer2 me-2"></i>Engine
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-shield-check me-2"></i>Brakes
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-lightning me-2"></i>Power
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-image me-2"></i>Image
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-calendar me-2"></i>Year
                                        </th>
                                        <th scope="col" class="border-0 py-3 text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <tr class="placeholder-wave">
                                            <td class="py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-light rounded-circle p-2 me-3 placeholder" style="width: 40px; height: 40px;"></div>
                                                    <div>
                                                        <div class="placeholder placeholder-lg col-8 mb-1"></div>
                                                        <div class="placeholder col-6"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3"><div class="placeholder col-10"></div></td>
                                            <td class="py-3"><div class="placeholder col-8"></div></td>
                                            <td class="py-3"><div class="placeholder col-9"></div></td>
                                            <td class="py-3"><div class="placeholder col-7"></div></td>
                                            <td class="py-3"><div class="placeholder col-12"></div></td>
                                            <td class="py-3"><div class="placeholder col-6"></div></td>
                                            <td class="py-3 text-end"><div class="placeholder col-12"></div></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (filteredMotorcycles.Count == 0)
                    {
                        <div class="text-center py-5 empty-state">
                            <i class="bi bi-search display-1 text-muted mb-3"></i>
                            <h5 class="text-muted">No motorcycles found</h5>
                            <p class="text-muted mb-0">Try adjusting your search criteria or 
                                <button class="btn btn-link p-0 fw-semibold" @onclick="ClearFilters">clear all filters</button>
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 modern-table">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-bicycle me-2"></i>Motorcycle
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-gear me-2"></i>Manufacturer
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-speedometer2 me-2"></i>Engine
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-shield-check me-2"></i>Brakes
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-lightning me-2"></i>Power
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-image me-2"></i>Image
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-calendar me-2"></i>Year
                                        </th>
                                        <th scope="col" class="border-0 py-3 text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var motorcycle in filteredMotorcycles)
                                    {
                                        <tr class="border-bottom">
                                            <td class="py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3 motorcycle-icon">
                                                        <i class="bi bi-bicycle text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-0 fw-semibold text-highlight">@motorcycle.MotorcycleName</h6>
                                                        <small class="text-muted">@motorcycle.EngineStyle Engine</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3">
                                                <span class="badge bg-success bg-opacity-75 manufacturer-badge">@motorcycle.Manufacturer</span>
                                            </td>
                                            <td class="py-3">
                                                <div>
                                                    <code class="cc-code">@motorcycle.MotorcycleCc CC</code>
                                                    <br />
                                                    <small class="text-muted">@motorcycle.EngineStyle</small>
                                                </div>
                                            </td>
                                            <td class="py-3">
                                                <span class="badge bg-secondary bg-opacity-75">@motorcycle.Brakes</span>
                                            </td>
                                            <td class="py-3">
                                                <div>
                                                    <span class="hp-torque-display">@motorcycle.Hp HP</span>
                                                    <br />
                                                    <small class="text-muted">@motorcycle.Torque Torque</small>
                                                </div>
                                            </td>
                                            <td class="py-3">
                                                <img src="Images/Home/Motorcycle/@motorcycle.Picture" 
                                                     width="80" height="60" 
                                                     class="border-0 rounded motorcycle-image" 
                                                     @onclick="() => RedirectToDetails(motorcycle)"
                                                     alt="@motorcycle.MotorcycleName" />
                                            </td>
                                            <td class="py-3">
                                                <span class="badge bg-warning bg-opacity-75 year-badge">@motorcycle.Year</span>
                                            </td>
                                            <td class="py-3 text-end">
                                                <div class="btn-group action-buttons" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-primary" 
                                                            title="View Details"
                                                            @onclick="() => RedirectToDetails(motorcycle)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm buy-button" 
                                                            title="Buy Now"
                                                            @onclick="() => RedirectToDetails(motorcycle)">
                                                        <i class="bi bi-cart-plus"></i> BUY
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public List<Motorcycle> motorcycles { get; set; } = new();

    private bool isLoading = false;
    private string nameFilter = string.Empty;
    private string manufacturerFilter = string.Empty;
    private string engineStyleFilter = string.Empty;
    private string yearFilter = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = motorcycles == null || motorcycles.Count == 0;
        await Task.Delay(100); // Simulate loading for demonstration
        isLoading = false;
        StateHasChanged();
    }

    private List<Motorcycle> filteredMotorcycles => motorcycles.Where(m =>
        (string.IsNullOrEmpty(nameFilter) || m.MotorcycleName.Contains(nameFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(manufacturerFilter) || m.Manufacturer.Contains(manufacturerFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(engineStyleFilter) || m.EngineStyle.Equals(engineStyleFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(yearFilter) || m.Year?.ToString().Equals(yearFilter) == true)
    ).ToList();

    private List<string> uniqueEngineStyles => motorcycles
        .Select(m => m.EngineStyle)
        .Distinct()
        .OrderBy(s => s)
        .ToList();

    private List<byte?> uniqueYears => motorcycles
        .Select(m => m.Year)
        .Distinct()
        .OrderBy(y => y)
        .ToList();

    private bool hasActiveFilters => !string.IsNullOrEmpty(nameFilter) || 
                                   !string.IsNullOrEmpty(manufacturerFilter) || 
                                   !string.IsNullOrEmpty(engineStyleFilter) || 
                                   !string.IsNullOrEmpty(yearFilter);

    private void ClearFilters()
    {
        nameFilter = string.Empty;
        manufacturerFilter = string.Empty;
        engineStyleFilter = string.Empty;
        yearFilter = string.Empty;
    }

    private async Task RedirectToDetails(Motorcycle motorcycle)
    {
        nav.NavigateTo($"/motorcycles/details/{motorcycle.Id.ToString()}");
    }
}
