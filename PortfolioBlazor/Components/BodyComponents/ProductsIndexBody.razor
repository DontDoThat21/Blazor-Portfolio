@using PortfolioBlazor.DTO.Models

<div class="container-fluid px-4">
    <!-- Header Section -->
    <div class="row align-items-center mb-4 pt-4">
        <div class="col-12 col-md-6">
            <h2 class="text-primary fw-bold mb-2">
                <i class="bi bi-book"></i> Product Library
            </h2>
            <p class="text-muted mb-0">Manage your book inventory</p>
        </div>
        <div class="col-12 col-md-6 mt-3 mt-md-0">
            <div class="d-flex gap-2 justify-content-md-end">
                <button class="btn btn-outline-secondary" @onclick="ClearFilters" disabled="@(isLoading)">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </button>
                <a class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-circle"></i> Create New Product
                </a>
            </div>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0 shadow-sm" 
                       placeholder="Search by title..." 
                       @bind="titleFilter" 
                       @bind:event="oninput"
                       disabled="@(isLoading)" />
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-person text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0 shadow-sm" 
                       placeholder="Search by author..." 
                       @bind="authorFilter" 
                       @bind:event="oninput"
                       disabled="@(isLoading)" />
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-upc-scan text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0 shadow-sm" 
                       placeholder="Search by ISBN..." 
                       @bind="isbnFilter" 
                       @bind:event="oninput"
                       disabled="@(isLoading)" />
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <select class="form-select shadow-sm" @bind="categoryFilter" disabled="@(isLoading)">
                <option value="">All Categories</option>
                @foreach (var category in uniqueCategories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
    </div>

    <!-- Results Summary -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                @if (isLoading)
                {
                    <small class="text-muted">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        Loading products...
                    </small>
                }
                else
                {
                    <small class="text-muted">
                        Showing <strong>@filteredProducts.Count</strong> of <strong>@products.Count</strong> products
                    </small>
                }
                @if (hasActiveFilters && !isLoading)
                {
                    <small class="text-info">
                        <i class="bi bi-funnel"></i> Filters active
                    </small>
                }
            </div>
        </div>
    </div>

    <!-- Products Table -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm product-table-card">
                <div class="card-body p-0">
                    @if (isLoading)
                    {
                        <!-- Loading Skeleton -->
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-book me-2"></i>Title
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-upc-scan me-2"></i>ISBN
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-currency-dollar me-2"></i>Price
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-person me-2"></i>Author
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-tags me-2"></i>Category
                                        </th>
                                        <th scope="col" class="border-0 py-3 text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <tr class="placeholder-wave">
                                            <td class="py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-light rounded-circle p-2 me-3 placeholder" style="width: 40px; height: 40px;"></div>
                                                    <div>
                                                        <div class="placeholder placeholder-lg col-8 mb-1"></div>
                                                        <div class="placeholder col-6"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3">
                                                <div class="placeholder col-10"></div>
                                            </td>
                                            <td class="py-3">
                                                <div class="placeholder col-8"></div>
                                            </td>
                                            <td class="py-3">
                                                <div class="placeholder col-9"></div>
                                            </td>
                                            <td class="py-3">
                                                <div class="placeholder col-7"></div>
                                            </td>
                                            <td class="py-3 text-end">
                                                <div class="placeholder col-12"></div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (filteredProducts.Count == 0)
                    {
                        <div class="text-center py-5 empty-state">
                            <i class="bi bi-search display-1 text-muted mb-3"></i>
                            <h5 class="text-muted">No products found</h5>
                            <p class="text-muted mb-0">Try adjusting your search criteria or 
                                <button class="btn btn-link p-0 fw-semibold" @onclick="ClearFilters">clear all filters</button>
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 modern-table">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-book me-2"></i>Title
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-upc-scan me-2"></i>ISBN
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-currency-dollar me-2"></i>Price
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-person me-2"></i>Author
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-tags me-2"></i>Category
                                        </th>
                                        <th scope="col" class="border-0 py-3 text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in filteredProducts)
                                    {
                                        <tr class="border-bottom">
                                            <td class="py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3 product-icon">
                                                        <i class="bi bi-book text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-0 fw-semibold text-highlight">@product.Title</h6>
                                                        @if (!string.IsNullOrEmpty(product.Description))
                                                        {
                                                            <small class="text-muted">@GetTruncatedDescription(product.Description)</small>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3">
                                                <code class="bg-light px-2 py-1 rounded isbn-code">@product.ISBN</code>
                                            </td>
                                            <td class="py-3">
                                                <div>
                                                    <span class="fw-bold text-success price-main">@product.Price.ToString("C")</span>
                                                    @if (product.ListPrice > product.Price)
                                                    {
                                                        <br />
                                                        <small class="text-muted text-decoration-line-through">@product.ListPrice.ToString("C")</small>
                                                        <small class="text-success ms-1">
                                                            (@(((product.ListPrice - product.Price) / product.ListPrice * 100).ToString("F0"))% off)
                                                        </small>
                                                    }
                                                </div>
                                            </td>
                                            <td class="py-3">
                                                <span class="badge bg-secondary bg-opacity-75 author-badge">@product.Author</span>
                                            </td>
                                            <td class="py-3">
                                                <span class="badge bg-primary bg-opacity-75 category-badge">@product.Category?.Name</span>
                                            </td>
                                            <td class="py-3 text-end">
                                                <div class="btn-group action-buttons" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-primary" 
                                                            title="View Details"
                                                            @onclick="() => ViewProduct(product.Id)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-warning" 
                                                            title="Edit"
                                                            @onclick="() => EditProduct(product.Id)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" 
                                                            title="Delete"
                                                            @onclick="() => DeleteProduct(product.Id)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public List<Product> products { get; set; } = new();

    private bool isLoading = false;
    private string titleFilter = string.Empty;
    private string authorFilter = string.Empty;
    private string isbnFilter = string.Empty;
    private string categoryFilter = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = products == null || products.Count == 0;
        await Task.Delay(100); // Simulate loading for demonstration
        isLoading = false;
        StateHasChanged();
    }

    private List<Product> filteredProducts => products.Where(p =>
        (string.IsNullOrEmpty(titleFilter) || p.Title.Contains(titleFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(authorFilter) || p.Author.Contains(authorFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(isbnFilter) || p.ISBN.Contains(isbnFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(categoryFilter) || p.Category.Name.Equals(categoryFilter, StringComparison.OrdinalIgnoreCase))
    ).ToList();

    private List<string> uniqueCategories => products
        .Select(p => p.Category?.Name)
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    private bool hasActiveFilters => !string.IsNullOrEmpty(titleFilter) || 
                                   !string.IsNullOrEmpty(authorFilter) || 
                                   !string.IsNullOrEmpty(isbnFilter) || 
                                   !string.IsNullOrEmpty(categoryFilter);

    private void ClearFilters()
    {
        titleFilter = string.Empty;
        authorFilter = string.Empty;
        isbnFilter = string.Empty;
        categoryFilter = string.Empty;
    }

    private string GetTruncatedDescription(string description)
    {
        if (string.IsNullOrEmpty(description)) return string.Empty;
        return description.Length > 60 ? description.Substring(0, 60) + "..." : description;
    }

    private void ViewProduct(int productId)
    {
        // Navigate to product details
        // Implementation would depend on your routing setup
    }

    private void EditProduct(int productId)
    {
        // Navigate to edit product
        // Implementation would depend on your routing setup
    }

    private void DeleteProduct(int productId)
    {
        // Show confirmation dialog and delete product
        // Implementation would depend on your deletion logic
    }
}