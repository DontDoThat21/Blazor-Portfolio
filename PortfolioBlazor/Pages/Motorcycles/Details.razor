@page "/motorcycles/details"
@using PortfolioBlazor.DTO.Models
@using PortfolioBlazor.Server.BL.Services
@using PortfolioBlazor.UI.Components.BodyComponents
@inject IMotorcyclesService MotorcyclesService

<MotorcyclesDetailsBody motorcycles="@motorcycle"/>

@code {
    Motorcycle motorcycle = new Motorcycle();

    protected override async Task OnInitializedAsync()
    {
        motorcycle = await MotorcyclesService.FetchMotorcycleAsync(motorcycle.Id);
    }
}
