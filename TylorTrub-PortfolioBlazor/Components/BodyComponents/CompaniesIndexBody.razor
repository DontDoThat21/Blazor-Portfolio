@using TylorTrubPortfolioBlazor.DTO.Models

<div class="container-fluid px-4">
    <!-- Header Section -->
    <div class="row align-items-center mb-4 pt-4">
        <div class="col-12 col-md-6">
            <h2 class="text-primary fw-bold mb-2">
                <i class="bi bi-building"></i> Company Directory
            </h2>
            <p class="text-muted mb-0">Manage your company listings</p>
        </div>
        <div class="col-12 col-md-6 mt-3 mt-md-0">
            <div class="d-flex gap-2 justify-content-md-end">
                <button class="btn btn-outline-secondary" @onclick="ClearFilters" disabled="@(isLoading)">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </button>
                <a class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-circle"></i> Create New Company
                </a>
            </div>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0 shadow-sm" 
                       placeholder="Search by name..." 
                       @bind="nameFilter" 
                       @bind:event="oninput"
                       disabled="@(isLoading)" />
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-geo-alt text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0 shadow-sm" 
                       placeholder="Search by city..." 
                       @bind="cityFilter" 
                       @bind:event="oninput"
                       disabled="@(isLoading)" />
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-telephone text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0 shadow-sm" 
                       placeholder="Search by phone..." 
                       @bind="phoneFilter" 
                       @bind:event="oninput"
                       disabled="@(isLoading)" />
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <select class="form-select shadow-sm" @bind="stateFilter" disabled="@(isLoading)">
                <option value="">All States</option>
                @foreach (var state in uniqueStates)
                {
                    <option value="@state">@state</option>
                }
            </select>
        </div>
    </div>

    <!-- Results Summary -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                @if (isLoading)
                {
                    <small class="text-muted">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        Loading companies...
                    </small>
                }
                else
                {
                    <small class="text-muted">
                        Showing <strong>@filteredCompanies.Count</strong> of <strong>@companies.Count</strong> companies
                    </small>
                }
                @if (hasActiveFilters && !isLoading)
                {
                    <small class="text-info">
                        <i class="bi bi-funnel"></i> Filters active
                    </small>
                }
            </div>
        </div>
    </div>

    <!-- Companies Table -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm product-table-card">
                <div class="card-body p-0">
                    @if (isLoading)
                    {
                        <!-- Loading Skeleton -->
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-building me-2"></i>Name
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-house me-2"></i>Address
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-geo-alt me-2"></i>City
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-pin-map me-2"></i>State
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-telephone me-2"></i>Phone
                                        </th>
                                        <th scope="col" class="border-0 py-3 text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <tr class="placeholder-wave">
                                            <td class="py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-light rounded-circle p-2 me-3 placeholder" style="width: 40px; height: 40px;"></div>
                                                    <div>
                                                        <div class="placeholder placeholder-lg col-8 mb-1"></div>
                                                        <div class="placeholder col-6"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3">
                                                <div class="placeholder col-10"></div>
                                            </td>
                                            <td class="py-3">
                                                <div class="placeholder col-8"></div>
                                            </td>
                                            <td class="py-3">
                                                <div class="placeholder col-6"></div>
                                            </td>
                                            <td class="py-3">
                                                <div class="placeholder col-9"></div>
                                            </td>
                                            <td class="py-3 text-end">
                                                <div class="placeholder col-12"></div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (filteredCompanies.Count == 0)
                    {
                        <div class="text-center py-5 empty-state">
                            <i class="bi bi-search display-1 text-muted mb-3"></i>
                            <h5 class="text-muted">No companies found</h5>
                            <p class="text-muted mb-0">Try adjusting your search criteria or 
                                <button class="btn btn-link p-0 fw-semibold" @onclick="ClearFilters">clear all filters</button>
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 modern-table">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-building me-2"></i>Name
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-house me-2"></i>Address
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-geo-alt me-2"></i>City
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-pin-map me-2"></i>State
                                        </th>
                                        <th scope="col" class="border-0 py-3">
                                            <i class="bi bi-telephone me-2"></i>Phone
                                        </th>
                                        <th scope="col" class="border-0 py-3 text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var company in filteredCompanies)
                                    {
                                        <tr class="border-bottom">
                                            <td class="py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3 product-icon">
                                                        <i class="bi bi-building text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-0 fw-semibold text-highlight">@company.Name</h6>
                                                        @if (!string.IsNullOrEmpty(company.PostalCode))
                                                        {
                                                            <small class="text-muted">Postal Code: @company.PostalCode</small>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3">
                                                @if (!string.IsNullOrEmpty(company.StreetAddress))
                                                {
                                                    <span class="text-dark">@company.StreetAddress</span>
                                                }
                                                else
                                                {
                                                    <small class="text-muted fst-italic">No address provided</small>
                                                }
                                            </td>
                                            <td class="py-3">
                                                @if (!string.IsNullOrEmpty(company.City))
                                                {
                                                    <span class="badge bg-info bg-opacity-75 author-badge">@company.City</span>
                                                }
                                                else
                                                {
                                                    <small class="text-muted fst-italic">—</small>
                                                }
                                            </td>
                                            <td class="py-3">
                                                @if (!string.IsNullOrEmpty(company.State))
                                                {
                                                    <span class="badge bg-success bg-opacity-75 category-badge">@company.State</span>
                                                }
                                                else
                                                {
                                                    <small class="text-muted fst-italic">—</small>
                                                }
                                            </td>
                                            <td class="py-3">
                                                @if (!string.IsNullOrEmpty(company.PhoneNumber))
                                                {
                                                    <a href="tel:@company.PhoneNumber" class="text-decoration-none">
                                                        <code class="bg-light px-2 py-1 rounded isbn-code">@company.PhoneNumber</code>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <small class="text-muted fst-italic">No phone</small>
                                                }
                                            </td>
                                            <td class="py-3 text-end">
                                                <div class="btn-group action-buttons" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-primary" 
                                                            title="View Details"
                                                            @onclick="() => ViewCompany(company.Id)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-warning" 
                                                            title="Edit"
                                                            @onclick="() => EditCompany(company.Id)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" 
                                                            title="Delete"
                                                            @onclick="() => DeleteCompany(company.Id)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public List<Company> companies { get; set; } = new();

    private bool isLoading = false;
    private string nameFilter = string.Empty;
    private string cityFilter = string.Empty;
    private string phoneFilter = string.Empty;
    private string stateFilter = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = companies == null || companies.Count == 0;
        await Task.Delay(100); // Simulate loading for demonstration
        isLoading = false;
        StateHasChanged();
    }

    private List<Company> filteredCompanies => companies.Where(c =>
        (string.IsNullOrEmpty(nameFilter) || c.Name.Contains(nameFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(cityFilter) || (!string.IsNullOrEmpty(c.City) && c.City.Contains(cityFilter, StringComparison.OrdinalIgnoreCase))) &&
        (string.IsNullOrEmpty(phoneFilter) || (!string.IsNullOrEmpty(c.PhoneNumber) && c.PhoneNumber.Contains(phoneFilter, StringComparison.OrdinalIgnoreCase))) &&
        (string.IsNullOrEmpty(stateFilter) || (!string.IsNullOrEmpty(c.State) && c.State.Equals(stateFilter, StringComparison.OrdinalIgnoreCase)))
    ).ToList();

    private List<string> uniqueStates => companies
        .Where(c => !string.IsNullOrEmpty(c.State))
        .Select(c => c.State)
        .Distinct()
        .OrderBy(s => s)
        .ToList();

    private bool hasActiveFilters => !string.IsNullOrEmpty(nameFilter) || 
                                   !string.IsNullOrEmpty(cityFilter) || 
                                   !string.IsNullOrEmpty(phoneFilter) || 
                                   !string.IsNullOrEmpty(stateFilter);

    private void ClearFilters()
    {
        nameFilter = string.Empty;
        cityFilter = string.Empty;
        phoneFilter = string.Empty;
        stateFilter = string.Empty;
    }

    private void ViewCompany(int companyId)
    {
        // Navigate to company details
        // Implementation would depend on your routing setup
    }

    private void EditCompany(int companyId)
    {
        // Navigate to edit company
        // Implementation would depend on your routing setup
    }

    private void DeleteCompany(int companyId)
    {
        // Show confirmation dialog and delete company
        // Implementation would depend on your deletion logic
    }
}