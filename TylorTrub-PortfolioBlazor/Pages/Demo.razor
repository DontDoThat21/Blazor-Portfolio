@page "/demo"

<PageTitle>Bootstrap Demo</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center text-primary">Bootstrap Migration Demo</h1>
            <div class="alert alert-success" role="alert">
                <h4 class="alert-heading">Migration Successful!</h4>
                <p>This page demonstrates that MudBlazor has been successfully replaced with native Bootstrap components.</p>
                <hr>
                <p class="mb-0">All MudBlazor dependencies have been removed and replaced with Bootstrap equivalents.</p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Before: MudBlazor Components</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">❌ MudLayout</li>
                        <li class="list-group-item">❌ MudAppBar</li>
                        <li class="list-group-item">❌ MudDrawer</li>
                        <li class="list-group-item">❌ MudNavLink</li>
                        <li class="list-group-item">❌ MudCard</li>
                        <li class="list-group-item">❌ MudButton</li>
                        <li class="list-group-item">❌ MudSimpleTable</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">After: Bootstrap Components</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">✅ Bootstrap Layout (div structure)</li>
                        <li class="list-group-item">✅ Bootstrap Navbar</li>
                        <li class="list-group-item">✅ Bootstrap Offcanvas</li>
                        <li class="list-group-item">✅ Bootstrap Links (anchor tags)</li>
                        <li class="list-group-item">✅ Bootstrap Card</li>
                        <li class="list-group-item">✅ Bootstrap Button</li>
                        <li class="list-group-item">✅ Bootstrap Table</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Sample Bootstrap Table</h5>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Component Type</th>
                                <th>Before (MudBlazor)</th>
                                <th>After (Bootstrap)</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Layout</td>
                                <td>MudLayout</td>
                                <td>div.d-flex</td>
                                <td><span class="badge bg-success">✅ Complete</span></td>
                            </tr>
                            <tr>
                                <td>Navigation</td>
                                <td>MudNavLink</td>
                                <td>anchor tags</td>
                                <td><span class="badge bg-success">✅ Complete</span></td>
                            </tr>
                            <tr>
                                <td>Cards</td>
                                <td>MudCard</td>
                                <td>div.card</td>
                                <td><span class="badge bg-success">✅ Complete</span></td>
                            </tr>
                            <tr>
                                <td>Buttons</td>
                                <td>MudButton</td>
                                <td>button.btn</td>
                                <td><span class="badge bg-success">✅ Complete</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="d-flex justify-content-center">
                <button class="btn btn-primary me-2">Primary Button</button>
                <button class="btn btn-secondary me-2">Secondary Button</button>
                <button class="btn btn-success">Success Button</button>
            </div>
        </div>
    </div>
</div>