@page "/projects/index"

@using TylorTrubPortfolioBlazor.DTO.Models
@using TylorTrubPortfolioBlazor.Server.BL.Services
@using System.Linq
@inject NavigationManager NavManager
@inject IProjectsService ProjectsService

<div class="row mb-3">
    <div class="col-12">
        <div class="input-group">
            <span class="input-group-text">
                <i class="fa fa-search"></i>
            </span>
            <input type="text" class="form-control" placeholder="Search projects..." @bind="searchText" @bind:event="oninput" />
        </div>
    </div>
</div>

<table class="table table-bordered table-striped">
    <tr>
        <th>
            Project Name
        </th>
        <th>
            Language
        </th>
        <th>
            Project details
        </th>
        <th>
            GitHub URL
        </th>
    </tr>
    <tbody>
        @foreach (var project in filteredProjects)
        {
            <tr>
                <td>
                    <a class="btn btn-primary" href="/Projects/@project.Name.ToString().Replace(" ", "")">@project.Name</a>
                </td>
                <td>
                    @project.Language
                </td>
                <td>
                    <a class="btn btn-primary" href="/Projects/@project.Name.ToString().Replace(" ", "")"><img src="/Images/project/@project.ProjectPhoto" width="400px" height="300px" /></a>
                </td>
                <td>
                    <a>
                        <a href="@project.Url">@project.Url</a>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    List<Project> projectList = new List<Project>();
    string searchText = string.Empty;

    List<Project> filteredProjects => string.IsNullOrWhiteSpace(searchText)
        ? projectList
        : projectList.Where(p => 
            (p.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.Language?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.Url?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
        ).ToList();

    protected override async Task OnInitializedAsync()
    {
        projectList = await ProjectsService.FetchProjectsAsync();
    }
}
